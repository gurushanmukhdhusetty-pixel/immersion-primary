# Copy this file to ".env.local" for running on your own computer.
# On Vercel, add these under Project → Settings → Environment Variables instead.

ADMIN_USERNAME=shlvyadmin
ADMIN_PASSWORD=choose-a-strong-password

# Optional: any long random text. Keeps logins valid even if you rename the admin user.
# SESSION_SECRET=

# Added automatically when you connect storage in Vercel (Storage tab) — do not type these by hand:
# KV_REST_API_URL=            (Upstash for Redis — orders & products)
# KV_REST_API_TOKEN=
# BLOB_READ_WRITE_TOKEN=      (Vercel Blob — uploaded images)
